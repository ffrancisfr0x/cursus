<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="contenido"
      stylesheets="@estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cursus.ui.EmpresasController">
    <padding>
        <Insets top="28.0" right="32.0" bottom="24.0" left="32.0"/>
    </padding>
    <children>

        <!-- Cabecera -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label text="Empresas" styleClass="titulo"/>
                        <Label fx:id="lblTotal" text="0 empresas" styleClass="subtitulo"/>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Nueva empresa" onAction="#nueva" styleClass="boton-primario"/>
            </children>
        </HBox>

        <!-- Tabla + formulario -->
        <HBox spacing="16.0" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="tabla" HBox.hgrow="ALWAYS" maxHeight="Infinity">
                    <columns>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="130.0"/>
                        <TableColumn fx:id="colSector" text="Sector" prefWidth="110.0"/>
                        <TableColumn fx:id="colWeb" text="Web" prefWidth="150.0"/>
                        <TableColumn fx:id="colRegistro" text="Registro" prefWidth="100.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="No hay empresas."/>
                    </placeholder>
                </TableView>

                <VBox spacing="12.0" styleClass="tarjeta"
                      prefWidth="240.0" minWidth="240.0" maxWidth="240.0">
                    <children>
                        <Label fx:id="lblFormulario" text="Nueva empresa" styleClass="titulo-seccion"/>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Nombre *" styleClass="etiqueta"/>
                                <TextField fx:id="txtNombre" promptText="Ej.: Indra"/>
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Sector" styleClass="etiqueta"/>
                                <ComboBox fx:id="cbSector" promptText="Elige o escribe"
                                          editable="true" maxWidth="Infinity"/>
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Web" styleClass="etiqueta"/>
                                <TextField fx:id="txtWeb" promptText="https://..."/>
                            </children>
                        </VBox>

                        <Label fx:id="lblMensaje" styleClass="texto-error" wrapText="true"/>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="btnBorrar" text="Borrar" onAction="#borrar" styleClass="boton-peligro"/>
                                <Button text="Guardar" onAction="#guardar" styleClass="boton-primario"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
