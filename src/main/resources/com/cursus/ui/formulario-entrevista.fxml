<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" prefWidth="340.0" styleClass="formulario"
      stylesheets="@estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.cursus.ui.FormularioEntrevistaController">
    <padding>
        <Insets top="22.0" right="24.0" bottom="22.0" left="24.0"/>
    </padding>
    <children>

        <Label fx:id="lblTitulo" text="Nueva entrevista" styleClass="titulo-seccion"/>

        <VBox spacing="4.0">
            <children>
                <Label text="Fecha *" styleClass="etiqueta"/>
                <DatePicker fx:id="dpFecha" maxWidth="Infinity"/>
            </children>
        </VBox>

        <VBox spacing="4.0">
            <children>
                <Label text="Tipo *" styleClass="etiqueta"/>
                <ComboBox fx:id="cbTipo" promptText="Elige el tipo" maxWidth="Infinity"/>
            </children>
        </VBox>

        <VBox spacing="4.0">
            <children>
                <Label text="Resultado *" styleClass="etiqueta"/>
                <ComboBox fx:id="cbResultado" maxWidth="Infinity"/>
            </children>
        </VBox>

        <VBox spacing="4.0">
            <children>
                <Label text="Notas" styleClass="etiqueta"/>
                <TextArea fx:id="txtNotas" prefRowCount="3" wrapText="true"/>
            </children>
        </VBox>

        <Label fx:id="lblError" styleClass="texto-error" wrapText="true"/>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button text="Cancelar" onAction="#cancelar" styleClass="boton-secundario"/>
                <Button text="Guardar" onAction="#guardar" styleClass="boton-primario"/>
            </children>
        </HBox>
    </children>
</VBox>
